# Copy to .env and fill in. .env is gitignored; this file is the committed
# record of which variables exist.
#
# There are no credentials: airplanes.live needs no authentication, so the
# pipeline runs with this file absent entirely. Everything below is an
# optional override of a working default (see config.py).

# AEROFEED_DB_PATH=local.db
# AEROFEED_WS_HOST=127.0.0.1
# AEROFEED_WS_PORT=8765

# Cell edge length in degrees. Each cell is covered by one point+radius query
# and airplanes.live caps radius at 250 nm, so values much above 6 stop fitting
# in a single request.
# AEROFEED_GRID_SIZE=5

# Seconds between polls. Each active cell costs one request and the poller
# paces them 1.1s apart to respect the provider's 1 req/s limit, so this needs
# headroom for the number of cells you expect to be subscribed.
# AEROFEED_POLL_INTERVAL=15

# Fallback subscription point for clients that pass no ?lat=&lon= override.
# AEROFEED_DEFAULT_LAT=40.7
# AEROFEED_DEFAULT_LON=-74.0
